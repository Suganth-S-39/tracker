# Copy to .env.local. Local values come from `npx supabase status -o env`
# (API_URL and PUBLISHABLE_KEY). Hosted values come from the Supabase dashboard
# (Project Settings > API Keys).
#
# Only the publishable key belongs here. Never put a secret / service-role key in any VITE_
# variable: everything prefixed with VITE_ is shipped to the browser.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
